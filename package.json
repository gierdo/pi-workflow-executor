{
  "name": "pi-workflow-executor",
  "version": "1.0.0",
  "description": "Transactional workflow executor and state-machine runner for Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "./index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "tui": "node --experimental-strip-types ./bin/tui.ts"
  },
  "bin": {
    "pi-workflow-tui": "./bin/tui.ts"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  }
}
